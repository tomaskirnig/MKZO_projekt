# ==========================================
node_modules/
dist/
build/
.cache/
.parcel-cache/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
!**/.env.example
*.local

# ==========================================
# SSL / TLS Certificates & Private Keys
# (Ochrana proti nechtěnému commitu tajných klíčů)
# ==========================================
*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.csr
certs/*
!certs/.gitkeep
!certs/generate-self-signed.sh
letsencrypt/
.certbot/

# ==========================================
# Database & Docker Persistent Volumes
# ==========================================
mariadb_data/
mysql_data/
db_data/
*.dump
*.sql.gz

# ==========================================
# SIP & WebRTC Diagnostics / Dumps
