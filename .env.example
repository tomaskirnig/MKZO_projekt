# ==========================================
# Kamailio WebRTC SIP Proxy - Konfigurace
# ==========================================

# Veřejná doména nebo subdoména (např. tvoje-domena.duckdns.org)
SIP_DOMAIN=example.duckdns.org

# Porty
SIP_PORT=5060
WS_PORT=8080
WSS_PORT=4443

# MariaDB Nastavení
MYSQL_ROOT_PASSWORD=kamailiorootpassword
MYSQL_DATABASE=kamailio
MYSQL_USER=kamailio
MYSQL_PASSWORD=kamailiopassword

# Cesta k certifikátům na hostiteli (obsahující privkey.pem a fullchain.pem)
# Pro Let's Encrypt na Oracle Cloud: /etc/letsencrypt/live/tvoje-domena.duckdns.org
# Pro lokální testování: ./certs
SSL_CERTS_DIR=./certs
